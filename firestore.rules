rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDocExists() {
      return request.auth != null && exists(userPath());
    }

    function userOrgId() {
      return userDocExists() ? get(userPath()).data.organizationId : null;
    }

    function userRole() {
      return userDocExists() ? get(userPath()).data.role : null;
    }

    function isPlatformAdmin() {
      return request.auth != null && (
        (userDocExists() && userRole() == 'platform_admin') ||
        request.auth.token.email in [
          'admin@greenzone.app'
        ]
      );
    }

    function isOrgAdmin() {
      return userDocExists() && userRole() == 'org_admin';
    }

    function sameOrg(orgId) {
      return userDocExists() && userOrgId() == orgId;
    }

    function legacyKazniizirkSample() {
      return resource.data.organizationId == null && userOrgId() == 'kazniizirk';
    }

    match /organizations/{orgId} {
      allow read: if request.auth != null && (isPlatformAdmin() || sameOrg(orgId));
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null && (
        uid == request.auth.uid ||
        isPlatformAdmin() ||
        (isOrgAdmin() && resource.data.organizationId == userOrgId())
      );
      allow create: if request.auth != null && uid == request.auth.uid;
      allow update: if request.auth != null && uid == request.auth.uid;
      allow delete: if false;
    }

    match /samples/{sampleId} {
      allow read: if request.auth != null && (
        isPlatformAdmin() ||
        legacyKazniizirkSample() ||
        (
          sameOrg(resource.data.organizationId) &&
          (
            userRole() == 'org_admin' ||
            (userRole() == 'inspector' && resource.data.userId == request.auth.uid)
          )
        )
      );

      allow create: if request.auth != null &&
        userDocExists() &&
        request.resource.data.organizationId == userOrgId() &&
        request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null &&
        userDocExists() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.organizationId == userOrgId() &&
        request.resource.data.userId == request.auth.uid;

      allow delete: if isPlatformAdmin();
    }

    match /enterprises/{docId} {
      allow read: if request.auth != null;
      allow write: if isPlatformAdmin();
    }

    match /daily_summaries/{docId} {
      allow read: if request.auth != null && isPlatformAdmin();
      allow write: if false;
    }

    match /meteostation/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /meteostation_photos/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
