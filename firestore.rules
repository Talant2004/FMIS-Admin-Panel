rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDocExists() {
      return request.auth != null && exists(userPath());
    }

    // Профиль без organizationId (создан приложением) = kazniizirk, как на сайте.
    function userOrgId() {
      return userDocExists() ? get(userPath()).data.get('organizationId', 'kazniizirk') : 'kazniizirk';
    }

    function userRole() {
      return userDocExists() ? get(userPath()).data.get('role', 'inspector') : 'inspector';
    }

    function isAdminEmail() {
      return request.auth != null && request.auth.token.email in [
        'admin@greenzone.app'
      ];
    }

    function isPlatformAdmin() {
      return request.auth != null && (
        (userDocExists() && userRole() == 'platform_admin') ||
        isAdminEmail()
      );
    }

    function isOrgAdmin() {
      return userDocExists() && userRole() == 'org_admin';
    }

    function sameOrg(orgId) {
      return userDocExists() && userOrgId() == orgId;
    }

    function legacyKazniizirkSample() {
      return resource.data.get('organizationId', null) == null && userOrgId() == 'kazniizirk';
    }

    function writesOwnSample() {
      return request.resource.data.get('userId', request.resource.data.get('uid', null)) == request.auth.uid;
    }

    function sampleOrgAllowed() {
      return request.resource.data.get('organizationId', null) == null ||
        request.resource.data.organizationId == userOrgId();
    }

    function ownsSample() {
      return request.auth != null && (
        resource.data.userId == request.auth.uid ||
        (resource.data.keys().hasAny(['uid']) && resource.data.uid == request.auth.uid) ||
        (
          request.auth.token.email is string &&
          resource.data.keys().hasAny(['userEmail']) &&
          resource.data.userEmail == request.auth.token.email
        )
      );
    }

    function teamPairId(otherUid) {
      return request.auth.uid < otherUid
        ? request.auth.uid + '_' + otherUid
        : otherUid + '_' + request.auth.uid;
    }

    function teamDoc(otherUid) {
      return /databases/$(database)/documents/inspector_teams/$(teamPairId(otherUid));
    }

    function isAcceptedTeammate(otherUid) {
      return otherUid is string
        && otherUid != request.auth.uid
        && exists(teamDoc(otherUid))
        && get(teamDoc(otherUid)).data.status == 'accepted';
    }

    match /organizations/{orgId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      // Роль сам себе можно поставить только inspector; админов назначает сервер.
      allow create: if request.auth != null && uid == request.auth.uid && (
        request.resource.data.get('role', 'inspector') == 'inspector' || isAdminEmail()
      );
      allow update: if request.auth != null && uid == request.auth.uid && (
        request.resource.data.get('role', null) == resource.data.get('role', null) ||
        (resource.data.get('role', null) == null && request.resource.data.get('role', 'inspector') == 'inspector') ||
        isAdminEmail()
      );
      allow delete: if false;
    }

    match /inspector_teams/{pairId} {
      // Без get на несуществующий документ приглашение падает: Missing or insufficient permissions.
      allow get: if request.auth != null;
      allow list: if request.auth != null && (
        isPlatformAdmin() ||
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId ||
        request.auth.uid == resource.data.userA ||
        request.auth.uid == resource.data.userB
      );

      allow create: if request.auth != null
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.status == 'pending'
        && pairId == teamPairId(request.resource.data.toUserId);

      allow update: if request.auth != null
        && resource.data.toUserId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId;

      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId ||
        request.auth.uid == resource.data.userA ||
        request.auth.uid == resource.data.userB
      );
    }

    match /samples/{sampleId} {
      allow read: if request.auth != null && (
        isPlatformAdmin() ||
        ownsSample() ||
        (isOrgAdmin() && legacyKazniizirkSample()) ||
        (sameOrg(resource.data.organizationId) && userRole() == 'org_admin') ||
        (userDocExists() && isAcceptedTeammate(resource.data.userId))
      );

      allow create: if request.auth != null &&
        writesOwnSample() &&
        sampleOrgAllowed();

      allow update: if request.auth != null &&
        ownsSample() &&
        writesOwnSample() &&
        sampleOrgAllowed();

      allow delete: if isPlatformAdmin();
    }

    match /enterprises/{docId} {
      allow read: if request.auth != null;
      allow write: if isPlatformAdmin();
    }

    match /daily_summaries/{docId} {
      allow read: if request.auth != null && isPlatformAdmin();
      allow write: if false;
    }

    match /meteostation/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /meteostation_photos/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
